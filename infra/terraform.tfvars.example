aws_account_id = "123456789012" # Replace with the account verified by the approved AWS wrapper.

# Empty registers no task definitions; use only a reviewed digest already present in Relay's ECR.
runtime_image_digest = ""
# Enable only after verifying the generated HTTPS endpoint; no path or trailing slash.
sandbox_origin = ""
# Starts billable service resources only after all deployment gates pass.
deploy_service = false
# Private operator mailbox goes only in ignored, owner-readable terraform.tfvars.
budget_alert_email = ""
# Reviewed public CA/password expiry; empty creates no expiry alert infrastructure.
# Before first apply, all reminders (30/seven/one day before expiry) must be in the future.
gateway_certificate_expires_at = ""
# Optional one-time alert-path check after confirmation; reviewed future UTC timestamp.
# Completed jobs are retained for evidence; never automatically reset this to the current time.
gateway_alert_validation_at = ""
