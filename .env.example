# Local development only. Do not reuse this password outside the local Podman container.
POSTGRES_PASSWORD=relay_local
RELAY_DATABASE_URL=postgres://relay:relay_local@127.0.0.1:5432/relay?sslmode=disable
RELAY_DATABASE_SCHEMA=p3_relay
# Local plaintext development only. ECS requires verified gateway TLS and injected CA PEM.
RELAY_DATABASE_CA_REQUIRED=false
RELAY_DATABASE_CA=
RELAY_HTTP_ADDRESS=:8080
RELAY_SOURCE_KEY=local-source
RELAY_INGRESS_SECRET=replace-with-at-least-16-bytes
RELAY_DELIVERY_SECRET=replace-with-a-different-16-byte-secret
RELAY_OPERATOR_TOKEN=replace-with-at-least-16-bytes
RELAY_DESTINATION_URL=http://127.0.0.1:9090/events?scenario=temporary_failure
# Local simulator only. Never enable this in a public deployment.
RELAY_ALLOW_PRIVATE_DESTINATIONS=true
# Sandbox stays disabled. Live visitor access requires same-origin HTTPS and a separate signing key.
# See docs/sandbox-contract.md; no private-network override is needed for visitor simulations.
RELAY_SANDBOX_ORIGIN=
RELAY_SANDBOX_KEY=
# Both empty selects PostgreSQL polling. Configured queues are validated at startup.
# Runtime AWS credentials must come from the approved credential chain/task role, not this file.
RELAY_SQS_QUEUE_URL=
RELAY_SQS_REGION=
