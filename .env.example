# Local development only. Do not reuse this password outside the local Podman container.
POSTGRES_PASSWORD=relay_local
RELAY_DATABASE_URL=postgres://relay:relay_local@127.0.0.1:5432/relay?sslmode=disable
RELAY_DATABASE_SCHEMA=p3_relay
RELAY_HTTP_ADDRESS=:8080
RELAY_SOURCE_KEY=local-source
RELAY_INGRESS_SECRET=replace-with-at-least-16-bytes
RELAY_DESTINATION_URL=http://127.0.0.1:9090/events
